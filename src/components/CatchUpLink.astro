---
const now = new Date();
const year = now.getUTCFullYear();
const month = String(now.getUTCMonth() + 1).padStart(2, '0');
const day = String(now.getUTCDate()).padStart(2, '0');
const todayStr = `${year}-${month}-${day}`;
const catchUpUrl = `/${todayStr}.xml`;
---

<section class="l-prose">
	<h2>Catch-Up Feed</h2>
	<p>
		Starting late or want to catch up on the most recent conference? Use today's catch-up link:
	</p>
	<p>
		<a href={catchUpUrl}>/{todayStr}.xml Direct Catch-Up Feed Link</a>
	</p>
	<p>
		The catch-up feed re-schedules all talks from the most recent session, spreading them evenly from today ({todayStr}) until the next conference so you can catch up at a steady pace.
	</p>
</section>
