---
import Layout from '@layouts/Base.astro';
import { getEligibleConferenceTalks, type ConferenceTalk } from '@utils/fetchConferenceTalks';
import { schedulePubDates, type ScheduledTalk } from '@utils/conferenceSchedule';

const buildTime = new Date();
const talks = await getEligibleConferenceTalks(buildTime);

// Group talks by conference
const talksByConference = new Map<string, ConferenceTalk[]>();
for (const talk of talks) {
  const key = `${talk.conferenceYear}-${talk.conferenceMonth}`;
  if (!talksByConference.has(key)) {
    talksByConference.set(key, []);
  }
  talksByConference.get(key)!.push(talk);
}

let latestConferenceLabel = "";
let releasedCount = 0;
let totalTalksCount = 0;
let nextScheduledItem: ScheduledTalk<ConferenceTalk> | null = null;

if (talksByConference.size > 0) {
  // Get the most recent conference key
  const keys = Array.from(talksByConference.keys()).sort();
  const latestKey = keys[keys.length - 1];
  const [yearStr, monthStr] = latestKey.split('-');
  const year = parseInt(yearStr, 10);
  const month = parseInt(monthStr, 10);
  const monthName = month === 4 ? "April" : "October";
  latestConferenceLabel = `${monthName} ${year}`;

  const confTalks = talksByConference.get(latestKey)!;
  totalTalksCount = confTalks.length;

  const scheduled = schedulePubDates(confTalks, year, month);
  const released = scheduled.filter(item => item.pubDate <= buildTime);
  releasedCount = released.length;

  const upcoming = scheduled.filter(item => item.pubDate > buildTime);
  if (upcoming.length > 0) {
    nextScheduledItem = upcoming[0];
  }
}
---

<Layout title="General Conference RSS Feed">
	<main class="u-guttered-lg l-stack l-space-xl">
		<section class="l-center l-space-m">
			<h1>General Conference RSS Feed</h1>
			<p class="u-step-1">
				A reliable, drip-fed RSS feed of General Conference talk links.
			</p>
		</section>

		<section class="l-switcher l-space-m">
			<div class="l-box l-stack l-space-s">
				<h2>Why this feed exists</h2>
				<p>
					The official Church RSS feeds have been unavailable for years. This project automatically scrapes official conference talk pages at build time and provides a modern RSS feed for your favorite feed reader.
				</p>
			</div>
			<div class="l-box l-stack l-space-s">
				<h2>How drip feeding works</h2>
				<p>
					Talks are evenly paced across the calendar gap between conferences in broadcast order. Instead of receiving 30+ talks at once on conference weekend, you receive a fresh talk every few days as you prepare for the next conference.
				</p>
			</div>
			<div class="l-box l-stack l-space-s">
				<h2>Current status & audio</h2>
				<p>
					The feed currently provides direct links and titles to conference talks (English, 2026 onwards). Audio enclosures are currently stubbed and will be added in a future update.
				</p>
			</div>
		</section>

		<section class="l-stack l-space-m l-box">
			<h2>Subscribe</h2>
			<p>
				Copy and paste the site URL directly into your RSS reader (autodiscovery will find the feed), or use the direct feed link:
			</p>
			<div class="l-cluster l-space-s">
				<a href="/rss.xml" role="button">/rss.xml Direct Feed Link</a>
			</div>
		</section>

		{latestConferenceLabel && (
			<section class="l-stack l-space-s l-box">
				<h2>Live Release Data ({latestConferenceLabel})</h2>
				<p>
					<strong>Released so far:</strong> {releasedCount} of {totalTalksCount} talks released for {latestConferenceLabel}.
				</p>
				{nextScheduledItem ? (
					<p>
						<strong>Next scheduled release:</strong> "{nextScheduledItem.talk.title}" {nextScheduledItem.talk.speaker ? `by ${nextScheduledItem.talk.speaker}` : ''} on {nextScheduledItem.pubDate.toUTCString()}.
					</p>
				) : (
					<p>All talks for {latestConferenceLabel} have been released!</p>
				)}
			</section>
		)}
	</main>
</Layout>
