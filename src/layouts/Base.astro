---
import ThemeToggle from "@components/ThemeToggle.astro";
import '../styles/styles.scss';

interface Props {
  title?: string;
}

const { title = "General Conference RSS Feed" } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="General Conference Talks" href="/rss.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
        <script is:inline>
			(function () {
				const stored = localStorage.getItem('theme');
				if (stored === 'light' || stored === 'dark') {
					document.documentElement.setAttribute('data-theme', stored);
				} else {
					document.documentElement.removeAttribute('data-theme');
				}
			})();
		</script>
		<header class="u-guttered-lg l-cluster">
			<div style="flex: 1;"><strong>General Conference Feed</strong></div>
			<ThemeToggle />
		</header>
		<main class="l-prose u-guttered">
			<slot />
		</main>
	</body>
</html>

<script>
	import logCommitHash from "lib/logCommitHash";
	// This makes it easy to see which version of the site is being served
	logCommitHash();
</script>
